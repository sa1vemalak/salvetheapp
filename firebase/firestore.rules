rules_version = '2';
// Access codes (invite-only phase). Assumed data model of the new paths:
//   admins/{uid}        exists for app administrators; written only from the server/console
//   config/app          { cadastroAberto: bool }   true = anyone may create a band
//   codigos/{codigo}    { ativo: bool, limite: int 1..10000, usados: int >= 0, nota: string <= 200, criadoEm: int, ultimaBanda?: string }
//   bands/{b}           { name: string 1..80, owner: uid, createdAt: int, codigo?: string }
// A new band needs: signup open, or an admin, or one use of an active code consumed in the same batch.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function memberDoc(b) { return /databases/$(database)/documents/bands/$(b)/members/$(request.auth.uid); }
    function member(b) { return signed() && exists(memberDoc(b)); }
    function role(b) { return get(memberDoc(b)).data.role; }
    function editor(b) { return member(b) && role(b) in ['dono', 'editor']; }
    function owner(b) { return member(b) && role(b) == 'dono'; }
    function isAdmin() { return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function codePath(c) { return /databases/$(database)/documents/codigos/$(c); }
    function signupOpen() {
      let cfg = /databases/$(database)/documents/config/app;
      return exists(cfg) && get(cfg).data.get('cadastroAberto', false) == true;
    }
    // the band being created consumed exactly one use of its code in this same batch
    function usedCode(b) {
      let c = request.resource.data.get('codigo', null);
      return c is string && c.size() > 0 && c.size() <= 64 && exists(codePath(c)) &&
        getAfter(codePath(c)).data.usados == get(codePath(c)).data.usados + 1 &&
        getAfter(codePath(c)).data.get('ultimaBanda', '') == b;
    }
    function isValidBand(d) {
      return d.keys().hasAll(['name', 'owner', 'createdAt']) && d.keys().hasOnly(['name', 'owner', 'createdAt', 'codigo']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 80 && d.owner is string && d.createdAt is int &&
        (!('codigo' in d) || (d.codigo is string && d.codigo.size() <= 64));
    }
    function isValidCode(d) {
      return d.keys().hasAll(['ativo', 'limite', 'usados']) && d.keys().hasOnly(['ativo', 'limite', 'usados', 'nota', 'criadoEm', 'ultimaBanda']) &&
        d.ativo is bool && d.limite is int && d.limite >= 1 && d.limite <= 10000 && d.usados is int && d.usados >= 0 &&
        (!('nota' in d) || (d.nota is string && d.nota.size() <= 200)) && (!('criadoEm' in d) || d.criadoEm is int) &&
        (!('ultimaBanda' in d) || (d.ultimaBanda is string && d.ultimaBanda.size() <= 120));
    }

    // each person: their list of bands and their private notes
    match /users/{uid} { allow read, write: if signed() && request.auth.uid == uid; }
    match /users/{uid}/{rest=**} { allow read, write: if signed() && request.auth.uid == uid; }

    match /bands/{b} {
      allow read: if member(b);
      allow create: if signed() && request.resource.data.owner == request.auth.uid && isValidBand(request.resource.data) &&
        (signupOpen() || isAdmin() || usedCode(b));
      allow update: if owner(b) && isValidBand(request.resource.data) &&
        request.resource.data.owner == resource.data.owner && request.resource.data.get('codigo', null) == resource.data.get('codigo', null);
      allow delete: if owner(b);

      match /members/{uid} {
        allow read: if member(b);
        // joining: your own entry, either as the band's creator or with a valid invite (with the invite's role)
        allow create: if signed() && uid == request.auth.uid && (
          (request.resource.data.role == 'dono' && get(/databases/$(database)/documents/bands/$(b)).data.owner == request.auth.uid) ||
          (request.resource.data.invite is string &&
           exists(/databases/$(database)/documents/bands/$(b)/invites/$(request.resource.data.invite)) &&
           request.resource.data.role == get(/databases/$(database)/documents/bands/$(b)/invites/$(request.resource.data.invite)).data.role));
        allow update: if owner(b) && request.resource.data.role in ['editor', 'musico'];
        allow delete: if owner(b) || (signed() && uid == request.auth.uid);
      }
      match /invites/{code} {
        allow get: if signed();
        allow list, write: if editor(b);
      }
      match /shows/{s} {
        allow read: if member(b);
        allow write: if editor(b);
        match /logic/{d} {
          allow read: if member(b);
          allow write: if editor(b);
        }
      }
      // songs, layout, ann (the shared "Em comum" layer), versions
      match /{col}/{doc} {
        allow read: if member(b);
        allow write: if editor(b) && !(col in ['members', 'invites', 'shows', 'jobs']);
      }
      // robot jobs: an editor asks, only the server updates them.
      // tipo 'audio' = Malak (score -> audio + bar map); tipo 'arranjo' = Mestrinho (recording -> horn arrangement)
      match /jobs/{j} {
        allow read: if member(b);
        allow create: if editor(b) && request.resource.data.keys().hasOnly(['song', 'tipo', 'bpm', 'status', 'criadoEm', 'uid', 'fonte']) &&
          request.resource.data.song is string && request.resource.data.song.size() <= 120 &&
          request.resource.data.status == 'pendente' &&
          request.resource.data.uid == request.auth.uid && request.resource.data.criadoEm is int &&
          ((request.resource.data.tipo == 'audio' &&
            (!('fonte' in request.resource.data) || request.resource.data.fonte in ['pdf', 'lido', 'partitura']) &&
            (!('bpm' in request.resource.data) || (request.resource.data.bpm is number && request.resource.data.bpm >= 20 && request.resource.data.bpm <= 320))) ||
           (request.resource.data.tipo == 'arranjo' && request.resource.data.get('fonte', '') == 'audio' &&
            !('bpm' in request.resource.data)));
        allow delete: if editor(b);
      }
      // each musician's rating (1-5) of an AI arrangement: one doc per person, only their own
      match /songs/{s}/avaliacoes/{u} {
        allow read: if member(b);
        allow create, update: if member(b) && u == request.auth.uid &&
          request.resource.data.keys().hasOnly(['nota', 'comentario', 'criadoEm', 'nome']) &&
          request.resource.data.nota is int && request.resource.data.nota >= 1 && request.resource.data.nota <= 5 &&
          request.resource.data.criadoEm is int &&
          (!('comentario' in request.resource.data) || (request.resource.data.comentario is string && request.resource.data.comentario.size() <= 500)) &&
          (!('nome' in request.resource.data) || (request.resource.data.nome is string && request.resource.data.nome.size() <= 80));
        allow delete: if (member(b) && u == request.auth.uid) || owner(b);
      }
    }

    // app administrators and signup settings
    match /admins/{uid} { allow read: if signed() && request.auth.uid == uid; }

    // the app team (admins + partners like the band's arranger): suggestions, the Mestrinho's writing rules,
    // lessons from corrected arrangements, training runs. Partners are added by the server only.
    function team() { return isAdmin() || (signed() && exists(/databases/$(database)/documents/equipe/$(request.auth.uid))); }
    function shortText(v, n) { return v is string && v.size() > 0 && v.size() <= n; }
    match /equipe/{uid} { allow read: if signed() && (request.auth.uid == uid || isAdmin()); }
    match /sugestoes/{id} {
      allow read: if team();
      allow create: if team() && request.resource.data.keys().hasOnly(['texto', 'uid', 'nome', 'criadoEm', 'status']) &&
        shortText(request.resource.data.texto, 2000) && request.resource.data.uid == request.auth.uid &&
        request.resource.data.criadoEm is int && request.resource.data.status == 'nova' &&
        (!('nome' in request.resource.data) || request.resource.data.nome is string && request.resource.data.nome.size() <= 80);
      // anyone on the team can move a suggestion along and answer it; the text and author stay
      allow update: if team() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resposta', 'atualizadoEm']) &&
        request.resource.data.status in ['nova', 'em andamento', 'feita', 'descartada'] &&
        (!('resposta' in request.resource.data) || request.resource.data.resposta is string && request.resource.data.resposta.size() <= 2000);
      allow delete: if isAdmin() || (team() && resource.data.uid == request.auth.uid);
    }
    // the writing rules the AI arranger follows (one doc, every edit keeps the text before it in /versoes)
    match /treino/regras {
      allow read: if team();
      allow write: if team() && request.resource.data.keys().hasOnly(['texto', 'uid', 'nome', 'atualizadoEm']) &&
        shortText(request.resource.data.texto, 20000) && request.resource.data.uid == request.auth.uid &&
        request.resource.data.atualizadoEm is int;
      match /versoes/{v} {
        allow read: if team();
        allow create: if team() && request.resource.data.keys().hasOnly(['texto', 'uid', 'nome', 'em']) &&
          shortText(request.resource.data.texto, 20000) && request.resource.data.em is int;
      }
    }
    // training rounds: a team member uploads a recording + the official score; the Mestrinho arranges blind, compares
    // and suggests lessons. The team asks; only the server updates the round.
    match /treino/regras/rodadas/{r} {
      allow read: if team();
      allow create: if team() && request.resource.data.keys().hasOnly(['titulo', 'guia', 'oficial', 'uid', 'nome', 'criadoEm', 'status']) &&
        shortText(request.resource.data.titulo, 120) && request.resource.data.uid == request.auth.uid &&
        request.resource.data.criadoEm is int && request.resource.data.status == 'pendente' &&
        request.resource.data.guia is map && request.resource.data.oficial is map &&
        request.resource.data.guia.src is string && request.resource.data.oficial.src is string &&
        request.resource.data.guia.src.size() < 2000 && request.resource.data.oficial.src.size() < 2000;
      allow delete: if isAdmin() || (team() && resource.data.uid == request.auth.uid);
    }
    // lessons: what an arranger changed in an AI arrangement, said in words (the AI reads the active ones)
    match /treino/regras/licoes/{id} {
      allow read: if team();
      allow create: if team() && request.resource.data.keys().hasOnly(['texto', 'musica', 'uid', 'nome', 'criadoEm', 'ativa']) &&
        shortText(request.resource.data.texto, 1500) && request.resource.data.uid == request.auth.uid &&
        request.resource.data.criadoEm is int && request.resource.data.ativa is bool &&
        (!('musica' in request.resource.data) || request.resource.data.musica is string && request.resource.data.musica.size() <= 120);
      allow update: if team() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativa', 'texto']) &&
        request.resource.data.ativa is bool && shortText(request.resource.data.texto, 1500);
      allow delete: if team();
    }
    match /config/app {
      allow read: if signed();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['cadastroAberto']) && request.resource.data.cadastroAberto is bool;
    }
    match /codigos/{c} {
      allow get: if signed();
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() && isValidCode(request.resource.data);
      // anyone signed in may consume ONE use, only while creating their own new band in the same batch
      allow update: if signed() && !isAdmin() && isValidCode(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usados', 'ultimaBanda']) &&
        resource.data.ativo == true &&
        request.resource.data.usados == resource.data.usados + 1 &&
        request.resource.data.usados <= resource.data.limite &&
        request.resource.data.ultimaBanda is string &&
        !exists(/databases/$(database)/documents/bands/$(request.resource.data.ultimaBanda)) &&
        getAfter(/databases/$(database)/documents/bands/$(request.resource.data.ultimaBanda)).data.get('codigo', '') == c &&
        getAfter(/databases/$(database)/documents/bands/$(request.resource.data.ultimaBanda)).data.owner == request.auth.uid;
    }

    // the old single-band collections (before bands existed) are closed to everyone
  }
}
