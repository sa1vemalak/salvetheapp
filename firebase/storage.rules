rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(band) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/bands/$(band)/members/$(request.auth.uid));
    }
    function editor(band) {
      return member(band) &&
        firestore.get(/databases/(default)/documents/bands/$(band)/members/$(request.auth.uid)).data.role in ['dono', 'editor'];
    }
    // each band's files: only its members read, only owner/editors write (up to 200 MB per file)
    match /bands/{band}/{path=**} {
      allow read: if member(band);
      allow write: if editor(band) && (request.resource == null || request.resource.size < 200 * 1024 * 1024);
    }
    // the app team's training files (recording + official score per round): only the team reads, each writes his own
    function team() {
      return request.auth != null && (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/equipe/$(request.auth.uid)));
    }
    match /treino/{uid}/{path=**} {
      allow read: if team();
      allow write: if team() && request.auth.uid == uid && (request.resource == null || request.resource.size < 200 * 1024 * 1024);
    }
    // the optional screenshot of a suggestion: each person writes in their own folder (images up to 8 MB, never replaced);
    // the sender and the app owner read it
    match /sugestoes/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    match /{other=**} { allow read, write: if false; }
  }
}
